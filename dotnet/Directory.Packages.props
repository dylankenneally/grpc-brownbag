<Project>
  <!-- central package management: every NuGet version is pinned here, once -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
    <PackageVersion Include="Grpc.AspNetCore" Version="2.84.0" />
    <PackageVersion Include="Grpc.AspNetCore.Server.Reflection" Version="2.84.0" />
    <PackageVersion Include="Grpc.AspNetCore.Web" Version="2.84.0" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.84.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.84.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
  </ItemGroup>
</Project>
