<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>BrownBag.Server</RootNamespace>
    <AssemblyName>BrownBag.Server</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.AspNetCore.Server.Reflection" />
    <PackageReference Include="Grpc.AspNetCore.Web" />
  </ItemGroup>

  <!-- Grpc.Tools turns each .proto into C# at build time; GrpcServices="Server" generates the abstract base class to override -->
  <ItemGroup>
    <Protobuf Include="$(ProtoRoot)\greeter\v1\greeter.proto" ProtoRoot="$(ProtoRoot)" GrpcServices="Server" Link="Protos\greeter\v1\greeter.proto" />
    <Protobuf Include="$(ProtoRoot)\lunch\v1\lunch.proto" ProtoRoot="$(ProtoRoot)" GrpcServices="Server" Link="Protos\lunch\v1\lunch.proto" />
  </ItemGroup>
</Project>
